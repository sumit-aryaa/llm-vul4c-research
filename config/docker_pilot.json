      "enabled": true,
      "base_url": "http://localhost:11434/v1",
      "model": "qwen2.5-coder:1.5b"
    },
    {
      "name": "ollama-qwen-7b",
      "provider": "openai_compatible",
      "enabled": true,
      "base_url": "http://localhost:11434/v1",
      "model": "qwen2.5-coder:7b",
      "require_api_key": false,
      "timeout_seconds": 600
    }
  ]
